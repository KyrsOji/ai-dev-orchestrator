# Example environment file for ai-dev-agent-heartbeat@.service
# Copy to /etc/ai-dev/agent-heartbeat-<instance>.env and edit values.

AGENT_ID=ofbiz-dev-01
# Comma-separated roles used by the heartbeat publisher
AGENT_ROLES=ofbiz,java,openhands-runner
# Optional human-readable status
AGENT_STATUS=idle
# Kafka bootstrap server
KAFKA_BOOTSTRAP=kafka.yahlife.com:9095
# Path to Java client properties for Kafka (optional)
KAFKA_CLIENT_CONFIG=/opt/ai-dev-runner/certs/kafka-client.properties
# Heartbeat interval in seconds
AGENT_HEARTBEAT_INTERVAL_SECONDS=60
