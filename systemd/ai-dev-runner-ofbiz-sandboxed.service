[Unit]
Description=AI Dev Runner OFBiz (sandboxed)
Documentation=
After=network.target

[Service]
Type=simple
# Run as a dedicated unprivileged user
User=openhands-runner
Group=openhands-runner

# Keep default behavior as dry-run unless explicitly overridden
Environment=RUNNER_MODE=dry-run
Environment=OPENHANDS_MODE=dry-run
Environment=RUNNER_LOG_DIR=/var/log/ai-dev-runner
Environment=RUNNER_BASE_DIR=/var/lib/ai-dev-runner/openhands-runs

# Working directory for run artifacts
WorkingDirectory=/opt/ai-dev-orchestrator

# Kafka environment and CLI defaults (system-wide kafka installation)
Environment=KAFKA_BOOTSTRAP=kafka.yahlife.com:9095
Environment=KAFKA_CLIENT_CONFIG=/opt/ai-dev-runner/certs/kafka-client.properties
Environment=KAFKA_FORCE_CLI=1
Environment=PATH=/usr/local/share/kafka/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Command - run the runner service module using system Python
# NOTE: Do NOT enable execute mode in this unit by default.
ExecStart=/usr/bin/env python3 -m runner.service
Restart=on-failure
RestartSec=5s

# Systemd sandboxing / hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
PrivateDevices=true
LockPersonality=true
# Restrict address families - keep conservative defaults (allow unix and IPv4/IPv6)
# PrivateNetwork=true creates an isolated namespace; combined with these directives
# the unit will be highly constrained by default.
# Removed PrivateNetwork to permit external Kafka network access
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Run-time writable path(s) for this service
ReadOnlyPaths=/opt/ai-dev-orchestrator
ReadWritePaths=/var/lib/ai-dev-runner/openhands-runs /var/log/ai-dev-runner

# Deny access to sensitive locations (keep home directories and SSH inaccessible)
InaccessiblePaths=/root /etc/ssh
# Ensure Kafka client certs remain accessible to the service
# (previously blocked; required when using KAFKA_CLIENT_CONFIG)

# Minimal capabilities (don't grant extra capabilities)
# CapabilityBoundingSet=CAP_AUDIT_WRITE CAP_KILL CAP_NET_BIND_SERVICE
# (left as default but NoNewPrivileges helps prevent escalation)

# Helpful limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
