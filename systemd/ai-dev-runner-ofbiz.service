[Unit]
Description=ai-dev-runner (OFBiz) - continuous dry-run service
After=network.target

[Service]
Type=simple
User=kojiyah
WorkingDirectory=/home/kojiyah/dev/ai-dev-orchestrator
Environment=KAFKA_BOOTSTRAP=kafka.yahlife.com:9095
Environment=KAFKA_CLIENT_CONFIG=/opt/ai-dev-runner/certs/kafka-client.properties
Environment=KAFKA_FORCE_CLI=1
Environment=PATH=/home/kojiyah/tools/kafka/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Runner mode: 'dry-run' (default) or 'execute'
Environment=RUNNER_MODE=dry-run
# Executor-level OpenHands mode (keeps OpenHands disabled by default)
Environment=OPENHANDS_MODE=dry-run
# Example settings to enable execution (edit unit or use a drop-in file):
# Environment=RUNNER_MODE=execute
# Environment=OPENHANDS_MODE=execute
# Environment=OPENHANDS_CMD=python3 -m openhands
# Environment=OPENHANDS_ARGS=--some-arg
# Environment=OPENHANDS_TIMEOUT_SECONDS=1800
ExecStart=/usr/bin/env python3 -m runner.service
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
